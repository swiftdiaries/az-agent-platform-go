# Copy to deploy/config/local.env, fill the required values, and use --env-file
# with both Compose files from the repository root. local.env is ignored by Git
# and excluded from the image build. Do not commit credentials or access tokens.
# The database URL uses the Compose service hostname and the same password below.
# Shape: postgres://agent_platform:<URL-encoded-password>@postgres:5432/agent_platform?sslmode=disable
DATABASE_URL=
POSTGRES_PASSWORD=
# Use a container-reachable Streamable HTTP Java MCP URL; localhost points
# to the app container.
# Endpoint allowlist as id=url[,id2=url2]; the ids are referenced by the tenant
# directory file. Required and non-empty.
AGENT_PLATFORM_MCP_ENDPOINTS=java-monolith=
# Inbound headers Chat copies into the credential forwarded to MCP.
AGENT_PLATFORM_CREDENTIAL_HEADERS=Cookie,Authorization
# Cost gate: open (default) or headers. headers sends attribution headers to
# the model endpoint; the enforcement point must accept them only from Agent
# (mTLS or network policy). COST_HEADERS is key=Header-Name pairs (keys: tenant,
# principal, conversation, run, journey, profile); blank uses the X-Agent-* defaults.
AGENT_PLATFORM_COST_GATE=open
AGENT_PLATFORM_COST_HEADERS=
# Use a real Keycloak realm issuer, its JWKS URL, and the access-token audience.
KEYCLOAK_JWT_ISSUER=
KEYCLOAK_JWKS_URL=
KEYCLOAK_JWT_AUDIENCE=
KEYCLOAK_JWT_SOURCE=authorization_bearer
KEYCLOAK_JWT_HEADER=Authorization
# JSON Pointers into your token; change /tenant if your realm uses another claim.
KEYCLOAK_USER_CLAIM_PATH=/sub
KEYCLOAK_TENANT_CLAIM_PATH=/tenant
KEYCLOAK_JWT_ALLOWED_ALGORITHMS=RS256
# Real Azure AI Foundry project endpoint/deployment and service-principal values.
# Host az login does not provide credentials inside the container.
AZ_AGENT_FOUNDRY_PROJECT_ENDPOINT=
AZ_AGENT_FOUNDRY_DEPLOYMENT=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
OTEL_SERVICE_NAME=az-agent-platform
OTEL_SERVICE_VERSION=local
# Optional direct Langfuse OTLP HTTP export. Use the full traces URL; the app
# does not append /v1/traces. Leave both empty to disable export.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://<host>/api/public/otel/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS='Authorization=Basic <base64(public:secret)>,x-langfuse-ingestion-version=4'
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
